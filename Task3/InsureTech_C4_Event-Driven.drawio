ell id="n15" value="&lt;b&gt;Системы страховых&lt;/b&gt;&lt;br&gt;&lt;b&gt;компаний (10)&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;API тарифов / ОСАГО" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="60" width="260" height="100" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Kafka&lt;/b&gt; [Event Streaming]&lt;br&gt;топики: insurance-products,&lt;br&gt;policy-issued" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;size=25;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1080" y="420" width="300" height="110" as="geometry"/></mxCell><mxCell id="n17" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="оплата (redirect) [HTTP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n5" target="n13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="525" y="210"/><mxPoint x="190" y="210"/></Array></mxGeometry></mxCell><mxCell id="n19" value="данные клиента [REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="тарифы, заявки [REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="данные клиента [REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n22" value="TCP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n6" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value="TCP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n7" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n24" value="TCP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n9" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n25" value="оплата [HTTP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n6" target="n13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="260"/><mxPoint x="190" y="260"/></Array></mxGeometry></mxCell><mxCell id="n26" value="оформление страховок [REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n14" target="n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="535" y="305"/><mxPoint x="760" y="305"/></Array></mxGeometry></mxCell><mxCell id="n27" value="тарифы [REST/SOAP/GraphQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n8" target="n15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="885" y="620"/><mxPoint x="1230" y="240"/><mxPoint x="1230" y="160"/></Array></mxGeometry></mxCell><mxCell id="n28" value="взаиморасчёты [REST/SOAP/GraphQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n9" target="n15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="620"/><mxPoint x="1420" y="160"/></Array></mxGeometry></mxCell><mxCell id="n29" value="publish: insurance-products&lt;br&gt;(Transactional Outbox + Debezium CDC)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n8" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n30" value="subscribe: insurance-products&lt;br&gt;(актуализация реплики тарифов)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n16" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n31" value="publish: policy-issued&lt;br&gt;(Transactional Outbox + Debezium CDC)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n6" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n32" value="subscribe: policy-issued&lt;br&gt;(накопление реестра)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n16" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n33" value="Изменения as-is → to-be:&lt;br&gt;1. REST-polling тарифов (core-app 15 мин, settlement раз в сутки) → подписка на поток insurance-products: реплики актуальны секунды, RPS на СК не растёт с числом потребителей.&lt;br&gt;2. Суточная REST-выгрузка оформленных страховок (settlement→core-app) → поток policy-issued: без ночных пиков и таймаутов на больших выгрузках.&lt;br&gt;3. Transactional Outbox + CDC (Debezium): событие и бизнес-изменение — одна транзакция, публикация без потерь (нет двойной записи).&lt;br&gt;4. Декомпозиция сервисов не менялась — изменён способ доставки данных." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFF9E6;strokeColor=#E6D878;rounded=1;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="300" height="290" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>