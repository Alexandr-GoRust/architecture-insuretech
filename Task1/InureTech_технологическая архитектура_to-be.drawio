20" y="200" width="760" height="560" as="geometry"/></mxCell><mxCell id="n19" value="Зона доступности B" style="text;html=1;fontSize=16;fontColor=#3A6EA5;" vertex="1" parent="1"><mxGeometry x="940" y="690" width="300" height="40" as="geometry"/></mxCell><mxCell id="n20" value="Application Load Balancer&lt;br&gt;L7, health check /health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=10;" vertex="1" parent="1"><mxGeometry x="960" y="240" width="280" height="70" as="geometry"/></mxCell><mxCell id="n21" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;" vertex="1" parent="1"><mxGeometry x="940" y="350" width="560" height="280" as="geometry"/></mxCell><mxCell id="n22" value="Kubernetes cluster B — независимый" style="text;html=1;fontSize=12;fontColor=#1A4E8A;" vertex="1" parent="1"><mxGeometry x="960" y="600" width="380" height="30" as="geometry"/></mxCell><mxCell id="n23" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;arcSize=10;" vertex="1" parent="1"><mxGeometry x="960" y="390" width="520" height="190" as="geometry"/></mxCell><mxCell id="n24" value="namespace InsureTech" style="text;html=1;fontSize=11;fontColor=#8A6D1A;" vertex="1" parent="1"><mxGeometry x="976" y="548" width="460" height="26" as="geometry"/></mxCell><mxCell id="n25" value="core-app ×N&lt;br&gt;HPA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="976" y="420" width="160" height="60" as="geometry"/></mxCell><mxCell id="n26" value="client-info ×N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1152" y="420" width="140" height="60" as="geometry"/></mxCell><mxCell id="n27" value="ins-product-&lt;br&gt;aggregator ×N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="976" y="486" width="160" height="60" as="geometry"/></mxCell><mxCell id="n28" value="ins-comp-&lt;br&gt;settlement ×N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1152" y="486" width="140" height="60" as="geometry"/></mxCell><mxCell id="n29" value="PostgreSQL&lt;br&gt;Patroni&lt;br&gt;replica" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1560" y="380" width="100" height="120" as="geometry"/></mxCell><mxCell id="n30" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;arcSize=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1540" y="350" width="140" height="180" as="geometry"/></mxCell><mxCell id="n31" value="Object Storage (S3): pgBackRest — инкрементальные бэкапы + архив WAL&lt;br&gt; каждые 15 минут → RPO ≤ 15 мин" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1140" y="820" width="420" height="90" as="geometry"/></mxCell><mxCell id="n32" value="статика" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.5;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n33" value="API / динамика" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.5;" edge="1" parent="1" source="n2" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n34" value="health check ✓" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.5;" edge="1" parent="1" source="n4" target="n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="75"/></Array></mxGeometry></mxCell><mxCell id="n35" value="health check ✓" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.5;" edge="1" parent="1" source="n4" target="n20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="75"/></Array></mxGeometry></mxCell><mxCell id="n36" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.5;" edge="1" parent="1" source="n7" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n37" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.5;" edge="1" parent="1" source="n20" target="n23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n38" value="потоковая репликация (Patroni, авто-failover) → RTO ≤ мин" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.5;" edge="1" parent="1" source="n16" target="n29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="340"/><mxPoint x="1600" y="340"/></Array></mxGeometry></mxCell><mxCell id="n39" value="бэкапы" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.5;" edge="1" parent="1" source="n16" target="n31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n40" value="бэкапы" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.5;" edge="1" parent="1" source="n29" target="n31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n41" value="Решения (комментарии)&lt;br&gt;1. Масштабирование: горизонтальное (HPA по CPU/RPS в каждом кластере); вертикальное — только точечно. Активный рост в регионах → несколько зон доступности.&lt;br&gt;2. K8s: НЕЗАВИСИМЫЕ кластеры в каждой зоне. Растянутый кластер требует низкой латентности межзон и рискует split-brain etcd; независимые изолируют отказ зоны, переключение трафика берёт на себя GSLB.&lt;br&gt;3. Фейловер: Active-Active на клиенте — GSLB держит обе зоны в ротации, при отказе зоны выводит её по health check (RTO — минуты ≤ 45 мин).&lt;br&gt;4. БД: Patroni (leader/replica) — авто-failover; бэкапы pgBackRest + WAL в S3 каждые 15 мин (RPO ≤ 15 мин).&lt;br&gt;5. Шардирование БД НЕ требуется: 50 ГБ, нагрузка покрывается репликацией и HPU приложений; шардирование усложнит транзакции без выгоды." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFF9E6;strokeColor=#E6D878;rounded=1;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="420" height="200" as="geometry"/></mxCell><mxCell id="n42" value="Одинаковое время загрузки в регионах:&lt;br&gt;CDN раздаёт статику из узлов,&lt;br&gt;ближайших к пользователю;&lt;br&gt;GSLB направляет API-трафик&lt;br&gt;в ближайшую зону." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFF9E6;strokeColor=#E6D878;rounded=1;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="480" y="820" width="300" height="120" as="geometry"/></mxCell><mxCell id="n43" value="Обозначения:&lt;br&gt;— пунктир: зона доступности / VM&lt;br&gt;— синий: кластер K8s&lt;br&gt;— жёлтый: namespace&lt;br&gt;— зелёный: поды сервисов&lt;br&gt;— оранжевый цилиндр: PostgreSQL&lt;br&gt;— фиолетовый: пользователь&lt;br&gt;— синий_hex: GSLB" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFF9E6;strokeColor=#E6D878;rounded=1;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1690" y="30" width="200" height="200" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
