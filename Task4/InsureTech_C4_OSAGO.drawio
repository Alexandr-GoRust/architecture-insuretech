eStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n9" target="n15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="620"/><mxPoint x="1420" y="160"/></Array></mxGeometry></mxCell><mxCell id="n29" value="publish: insurance-products&lt;br&gt;(Transactional Outbox + Debezium CDC)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n8" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n30" value="subscribe: insurance-products&lt;br&gt;(актуализация реплики тарифов)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n16" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n31" value="publish: policy-issued&lt;br&gt;(Transactional Outbox + Debezium CDC)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n6" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n32" value="subscribe: policy-issued&lt;br&gt;(накопление реестра)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n16" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n33" value="&lt;b&gt;osago-aggregator&lt;/b&gt;&lt;br&gt;[Container: Kotlin, SpringBoot]&lt;br&gt;заявки ОСАГО в СК,&lt;br&gt;опрос решений (≤60 c)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760" y="800" width="250" height="120" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;osago-db&lt;/b&gt;&lt;br&gt;[PostgreSQL]&lt;br&gt;заявки/статусы" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1060" y="820" width="110" height="80" as="geometry"/></mxCell><mxCell id="n35" value="создание заявки ОСАГО [REST]&lt;br&gt;[Timeout][Retry][Circuit Breaker]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n6" target="n33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="800"/></Array></mxGeometry></mxCell><mxCell id="n36" value="publish: osago-offers&lt;br&gt;(предложения по мере ответа СК)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n33" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n37" value="subscribe: osago-offers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n16" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n38" value="заявка / опрос решения [REST]&lt;br&gt;[Timeout 60s][Retry][Circuit Breaker][Rate Limiting]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5B7DB1;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n33" target="n15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="780"/><mxPoint x="1330" y="780"/><mxPoint x="1330" y="200"/></Array></mxGeometry></mxCell><mxCell id="n39" value="TCP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n33" target="n34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n40" value="WS: поток предложений ОСАГО&lt;br&gt;(по мере поступления) [WebSocket]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=1.6;dashed=0;fontSize=10;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="300"/><mxPoint x="640" y="300"/></Array></mxGeometry></mxCell><mxCell id="n41" value="Решения Task4:&lt;br&gt;1. osago-aggregator — свой API + СВОЯ БД (osago-db): заявки и статусы живут у него, опрос решений (до 60 c) не зависит от сессии core-app, переживает рестарты.&lt;br&gt;2. API core-app→osago: REST (команда «создать заявку», точка-точка); результаты — события osago-offers в Kafka (по мере ответа каждой СК).&lt;br&gt;3. API веб→core-app: REST (создание заявки) + WebSocket-канал потока предложений — Server push, отображение сразу по приходу оффера (кейс урока front-to-back).&lt;br&gt;4. Паттерны (бейджи на стрелках): к СК — Timeout 60s, Retry, Circuit Breaker, Rate Limiting; core-app→osago — Timeout/Retry/CB; веб→core-app — Rate Limiting (2500 польз.).&lt;br&gt;5. Множественные экземпляры: офферы публикуются в Kafka → их видят ВСЕ экземпляры core-app; WebSocket конкретного пользователя закреплён за его экземпляром — решение от количества экземпляров не зависит." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FFF9E6;strokeColor=#E6D878;rounded=1;spacing=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="300" height="400" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>